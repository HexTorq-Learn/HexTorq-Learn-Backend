generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum WatchEventType {
  PLAY
  PAUSE
  SEEK
  BUFFER
  END
  TAB_HIDDEN
  TAB_VISIBLE
  WINDOW_BLUR
  WINDOW_FOCUS
  IDLE_START
  IDLE_END
  FLUSH
}

model User {
  id             String                @id @default(cuid())
  name           String
  email          String                @unique
  username       String?
  phone          String?
  passwordHash   String
  role           UserRole              @default(STUDENT)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sessions       WatchSession[]
  events         WatchEvent[]
  heatmap        VideoSecondHeatmap[]
  summaries      DailyWatchSummary[]
  portalSessions PortalSession[]
  portalEvents   PortalActivityEvent[]
  portalSummaries DailyPortalSummary[]
  notifications  Notification[]

  @@index([createdAt])
}

model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#1f6f64")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]

  @@index([sortOrder, createdAt])
}

model Video {
  id          String              @id @default(cuid())
  youtubeId   String              @unique
  title       String
  url         String
  playlistId  String?
  durationSec Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  playlist    Playlist?           @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  sessions    WatchSession[]
  events      WatchEvent[]
  heatmap     VideoSecondHeatmap[]
  summaries   DailyWatchSummary[]

  @@index([createdAt])
  @@index([playlistId])
}

model WatchSession {
  id        String       @id @default(cuid())
  userId    String
  videoId   String?
  loginAt   DateTime     @default(now())
  logoutAt  DateTime?
  userAgent String?
  ipAddress String?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video?       @relation(fields: [videoId], references: [id], onDelete: SetNull)
  events    WatchEvent[]

  @@index([userId, loginAt])
  @@index([videoId, loginAt])
}

model WatchEvent {
  id           String         @id @default(cuid())
  userId       String
  videoId      String
  sessionId    String?
  eventType    WatchEventType
  videoTimeSec Float?
  fromTimeSec  Float?
  toTimeSec    Float?
  clientTs     DateTime
  serverTs     DateTime       @default(now())
  metadata     Json?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  video        Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  session      WatchSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, videoId, serverTs])
  @@index([serverTs])
  @@index([userId, serverTs])
  @@index([videoId, serverTs])
  @@index([userId, eventType, serverTs])
  @@index([eventType])
}

model VideoSecondHeatmap {
  id         String   @id @default(cuid())
  userId     String
  videoId    String
  second     Int
  watchCount Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId, second])
  @@index([videoId, second])
  @@index([userId, videoId])
  @@index([userId, watchCount])
  @@index([watchCount])
}

model DailyWatchSummary {
  id                 String   @id @default(cuid())
  userId             String
  videoId            String
  date               DateTime
  activeWatchSeconds Int      @default(0)
  pauseCount         Int      @default(0)
  seekCount          Int      @default(0)
  sessionCount       Int      @default(0)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video              Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId, date])
  @@index([userId, date])
  @@index([date])
  @@index([videoId, date])
}

model AdvancedMetricsSnapshot {
  userId       String   @id
  metrics      Json
  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([calculatedAt])
}

// Portal-wide activity tracking (login/idle/logout), independent of whether a
// video is open -- distinct from WatchSession/WatchEvent which only exist while
// a video player is mounted. Provisioned via raw SQL in databaseEnsure.js
// (see AdvancedMetricsSnapshot above for the same pattern), not a formal migration.
model PortalSession {
  id         String                @id @default(cuid())
  userId     String
  loginAt    DateTime              @default(now())
  logoutAt   DateTime?
  lastSeenAt DateTime              @default(now())
  userAgent  String?
  ipAddress  String?
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     PortalActivityEvent[]

  @@index([userId, loginAt])
  @@index([lastSeenAt])
}

model PortalActivityEvent {
  id        String         @id @default(cuid())
  userId    String
  sessionId String?
  eventType String
  clientTs  DateTime
  serverTs  DateTime       @default(now())
  metadata  Json?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   PortalSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, serverTs])
  @@index([serverTs])
  @@index([userId, eventType, serverTs])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  severity    String    @default("medium")
  title       String
  message     String
  channel     String    @default("portal")
  read        Boolean   @default(false)
  emailSentAt DateTime?
  emailError  String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, type, createdAt])
}

model DailyPortalSummary {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  activeSeconds Int      @default(0)
  idleSeconds   Int      @default(0)
  loginCount    Int      @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}
